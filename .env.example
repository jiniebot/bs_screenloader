MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-32-byte-hex-string
JWT_TTL=8h
UPLOADS_DIR=./uploads
OUTPUTS_DIR=./outputs
TEMP_DIR=./tmp

# Default canvas size
CANVAS_W=1920
CANVAS_H=1080

# Template directories
TEMPLATE_MENS=source mens proj
TEMPLATE_WOMENS=source womens proj

# FTP
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
FTP_SECURE=false
FTP_REMOTE_ROOT=/public_html/videos_dev/

# Cloudflare R2 (raw source video archive)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Worker
JOB_POLL_MS=5000

# Duration defaults
DURATION_MIN_SEC=1
DURATION_MAX_SEC=

# Upload link expiry
LINK_EXPIRY_DAYS=7

# Screen defaults (seeded by npm run seed:screens)
SCREEN_WOMENS_BASE=
SCREEN_MENS_BASE=
